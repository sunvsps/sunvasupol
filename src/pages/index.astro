---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="hero-title">Hi, I'm Sun Vasupol!</h1>
			<p class="subtitle">
				💻 System Architect · 📊 Data Platforms · ☕ Java &amp; Spring Boot
			</p>

			<section class="intro">
				<p class="eyebrow">About Me</p>

				<h1>
					Architecting resilient data platforms<br />
					and backend systems
				</h1>

				<p class="lead">
					With over <strong>7 years of experience</strong> at ExxonMobil, I've grown from a
					backend developer into a System Architect, now designing scalable data ingestion
					patterns on <strong>Snowflake</strong> and leading the architecture behind
					<strong>Java Spring Boot</strong> microservices used across the business.
				</p>
			</section>

			<section class="experience">
				<h2>Experience</h2>

				<!-- Company -->
				<div class="company">
					<div class="company-header">
						<img
							src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/Exxon_Mobil_Logo.svg/1280px-Exxon_Mobil_Logo.svg.png"
							alt="ExxonMobil"
							class="company-logo"
						/>
						<div>
							<span class="company-meta">Full-time · 7 yrs 2 mos</span>
						</div>
					</div>

					<div class="timeline">
						<div class="role">
							<div class="marker">
								<span class="dot"></span>
								<span class="line"></span>
							</div>
							<div class="content">
								<h4>System Architect</h4>
							</div>
						</div>

						<div class="role">
							<div class="marker">
								<span class="dot"></span>
								<span class="line"></span>
							</div>
							<div class="content">
								<h4>Software System Architect</h4>
							</div>
						</div>

						<div class="role">
							<div class="marker">
								<span class="dot"></span>
							</div>
							<div class="content">
								<h4>Back End Developer</h4>
							</div>
						</div>
					</div>
				</div>

				<!-- Company -->
				<div class="company">
					<div class="company-header">
						<img
							src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/Exxon_Mobil_Logo.svg/1280px-Exxon_Mobil_Logo.svg.png"
							alt="ExxonMobil"
							class="company-logo"
						/>
						<div>
							<span class="company-meta">Internship · 7 mos</span>
						</div>
					</div>

					<div class="timeline">
						<div class="role">
							<div class="marker">
								<span class="dot"></span>
								<span class="line"></span>
							</div>
							<div class="content">
								<h4>Frontend Web Developer</h4>
							</div>
						</div>

						<div class="role">
							<div class="marker">
								<span class="dot"></span>
							</div>
							<div class="content">
								<h4>Chatbot Developer</h4>
							</div>
						</div>
					</div>
				</div>

				<!-- Company -->
				<div class="company">
					<div class="company-header">
						<div>
							<h3 class="company-name">Kasetsart University</h3>
							<span class="company-meta">Part-time · 1 yr</span>
						</div>
					</div>

					<div class="timeline">
						<div class="role">
							<div class="marker">
								<span class="dot"></span>
							</div>
							<div class="content">
								<h4>Teacher Assistant</h4>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="tech-stack">
				<h2>Tech Stack</h2>

				<div class="stack-group">
					<h3>Frontend</h3>
					<div class="logos">
						<img src="https://cdn.simpleicons.org/vuedotjs" alt="Vue.js" title="Vue.js" />
						<img src="https://cdn.simpleicons.org/angular" alt="Angular" title="Angular" />
					</div>
				</div>

				<div class="stack-group">
					<h3>Backend</h3>
					<div class="logos">
						<img src="https://cdn.simpleicons.org/springboot" alt="Spring Boot" title="Spring Boot" />
						<img src="https://cdn.simpleicons.org/openjdk" alt="Java" title="Java" />
						<img src="https://cdn.simpleicons.org/python" alt="Python" title="Python" />
					</div>
				</div>

				<div class="stack-group">
					<h3>Data & Warehousing</h3>
					<div class="logos">
						<img src="https://cdn.simpleicons.org/snowflake" alt="Snowflake" title="Snowflake" />
						<img src="https://cdn.simpleicons.org/qlik" alt="Qlik" title="Qlik" />
					</div>
				</div>

				<div class="stack-group">
					<h3>Cloud & DevOps</h3>
					<div class="logos">
						<img src="https://api.iconify.design/simple-icons:microsoftazure.svg" alt="Microsoft Azure" title="Microsoft Azure" />
						<img src="https://cdn.simpleicons.org/terraform" alt="Terraform" title="Terraform" />
					</div>
				</div>
			</section>

			<section class="specialties">
				<div class="card">
					<h3>Data Platform Architecture</h3>
					<p>
						Designing standardized ingestion patterns on Snowflake, with ETL pipelines
						built on Qlik and Azure Data Factory to power a trusted foundation layer.
					</p>
					<span>Snowflake · ADF · Data Governance</span>
				</div>

				<div class="card">
					<h3>Microservices & Backend</h3>
					<p>
						Leading design and technical strategy for scalable, maintainable
						microservices built with Java and Spring Boot.
					</p>
					<span>Java · Spring Boot · REST APIs</span>
				</div>

				<div class="card">
					<h3>Infrastructure as Code</h3>
					<p>
						Supporting CI/CD and cloud infrastructure management with
						Infrastructure as Code and DevOps best practices.
					</p>
					<span>Terraform · CI/CD</span>
				</div>
			</section>

			<section class="skills">
				<h2>Skills</h2>

				<div class="grid">
					<div>
						<h4>Architecture</h4>
						<ul>
							<li>Software Architecture</li>
							<li>System & Data Modeling</li>
							<li>Data Governance</li>
						</ul>
					</div>

					<div>
						<h4>Data & Cloud</h4>
						<ul>
							<li>Snowflake</li>
							<li>Microsoft Azure</li>
							<li>Terraform</li>
						</ul>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section {
		max-width: 960px;
		margin: 5rem auto;
		padding: 0 1.5rem;
	}

	.eyebrow {
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		color: #6366f1;
	}

	h1 {
		font-size: 2.5rem;
		margin: 0.5rem 0 1rem;
		line-height: 1.2;
	}

	.lead {
		font-size: 1.1rem;
		color: #444;
		max-width: 720px;
	}

	.specialties {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.card {
		padding: 1.5rem;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		background: #fff;
	}

	.card h3 {
		margin-bottom: 0.5rem;
	}

	.card span {
		display: block;
		margin-top: 1rem;
		font-size: 0.85rem;
		color: #6b7280;
	}

	.skills .grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	h4 {
		margin-bottom: 0.5rem;
	}

	ul {
		padding-left: 1rem;
		color: #4b5563;
	}

	li {
		margin-bottom: 0.4rem;
	}

	.hero-title {
		font-size: clamp(2.8rem, 7vw, 4.2rem);
		font-weight: 800;
		background: linear-gradient(90deg, #6366f1, #22c55e);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.03em;
	}

	.subtitle {
		font-weight: 400;
		letter-spacing: 0.4px;
		opacity: 0.7;
	}

	.tech-stack h2 {
		margin-bottom: 3rem;
	}

	.stack-group {
		margin-bottom: 3rem;
	}

	.stack-group h3 {
		font-size: 1rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #6b7280;
		margin-bottom: 1.2rem;
	}

	.logos {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(48px, 1fr));
		gap: 1.5rem;
		align-items: center;
	}

	.logos img {
		width: 36px;
		height: 36px;
		opacity: 0.8;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.logos img:hover {
		opacity: 1;
		transform: translateY(-2px) scale(1.05);
	}

	.experience {
		max-width: 900px;
	}

	.company {
		margin-bottom: 4rem;
	}

	.company-name {
		margin: 0;
		font-size: 1.1rem;
	}

	.company-meta {
		font-size: 0.85rem;
		color: #6b7280;
	}

	.company-header {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.company-logo {
		height: 32px;
		width: auto;
		max-width: 180px;
		object-fit: contain;
	}

	.timeline {
		margin-top: 2rem;
	}

	.role {
		display: grid;
		grid-template-columns: 40px 1fr;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.marker {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.dot {
		width: 14px;
		height: 14px;
		background: #2563eb;
		border-radius: 50%;
		z-index: 2;
	}

	.line {
		position: absolute;
		top: 18px;
		bottom: -28px;
		width: 2px;
		background: #e5e7eb;
	}

	.role:last-child .line {
		display: none;
	}

	.content h4 {
		font-size: 1.05rem;
		font-weight: 600;
	}
</style>
